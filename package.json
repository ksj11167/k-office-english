    "playwright": "^1.56.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capgo/capacitor-share-target": "^8.0.52",
    "@capgo/capacitor-speech-recognition": "^8.3.0"
  }
}
